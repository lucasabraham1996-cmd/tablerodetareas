    function esc(v=""){
      return String(v).replace(/[&<>"']/g, m => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[m]));
    }

    function uniqueAreas(){
      const seeded = columnDefs.map(c => c.name);
      const extras = [...new Set(tasks.map(t => t.area).filter(a => !seeded.includes(a)))];
      return [...seeded, ...extras];
    }

    function columnInfo(name){
      return columnDefs.find(c => c.name === name) || {name, color:"#4379ff", icon:"circle-dot"};
    }

    function parseDate(s){
      if(!s) return null;
      const d = new Date(s + "T00:00:00");
      return isNaN(d.getTime()) ? null : d;
    }

    function startOfDay(d=new Date()){
      return new Date(d.getFullYear(), d.getMonth(), d.getDate());
    }

    function dayDiff(s){
      const d = parseDate(s);
      if(!d) return null;
      return Math.round((startOfDay(d) - startOfDay()) / 86400000);
    }

    function deadlineLabel(s){
      const diff = dayDiff(s);
      if(diff === null) return "";
      if(diff < 0) return `Vencida hace ${Math.abs(diff)} día${Math.abs(diff)===1?"":"s"}`;
      if(diff === 0) return "Vence hoy";
      if(diff === 1) return "Vence mañana";
      return `Vence en ${diff} días`;
    }

    function priorityLabel(p){
      return p === "alta" ? "Alta" : p === "baja" ? "Baja" : "Media";
    }

    function hexToRgb(hex){
      let clean = String(hex || "").replace("#","").trim();
      if(clean.length === 3) clean = clean.split("").map(ch => ch + ch).join("");
      if(clean.length !== 6) return {r:217,g:226,b:239};
      const num = parseInt(clean, 16);
      return {r:(num>>16)&255, g:(num>>8)&255, b:num&255};
    }

    function taskStyle(statusId){
      const status = statusById(statusId);
      const {r,g,b} = hexToRgb(status.color);
      const bg = `rgba(${r},${g},${b},0.33)`;   // leve, no invasivo
      const border = `rgba(${r},${g},${b},0.72)`;
      const accent = `rgba(${r},${g},${b},1)`;
      return `background:${bg}; border-color:${border}; --accent:${accent};`;
    }

    function colorSwatchStyle(hex, alpha=.33){
      const {r,g,b} = hexToRgb(hex);
      return `background:rgba(${r},${g},${b},${alpha}); border-color:rgba(${r},${g},${b},.72);`;
    }

