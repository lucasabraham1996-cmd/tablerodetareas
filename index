                ${t.deadline ? `<span class="tag"><i data-lucide="calendar-days"></i> ${esc(deadlineLabel(t.deadline))}</span>` : ""}
                ${t.priority ? `<span class="tag">Prioridad ${priorityLabel(t.priority)}</span>` : ""}
                ${t.owner ? `<span class="tag"><i data-lucide="user-round"></i> ${esc(t.owner)}</span>` : ""}
              </div>
              ${attachmentListHtml(t.attachments)}
            </div>
          </div>
          <div class="task-actions">
            <button class="mini" onclick="editTask('${t.id}')">Editar</button>
            <button class="mini" onclick="duplicateTask('${t.id}')">Duplicar</button>
            <button class="mini" onclick="deleteTask('${t.id}')">Eliminar</button>
          </div>
        </article>
      `;
    }

