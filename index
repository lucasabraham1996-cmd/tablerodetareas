      "Jornada de Puertas Abiertas":["puertas abiertas","expo carreras","jornada","folleto"],
      "No inicios":["no inicio","no iniciaron","no inicia","no iniciaron clases"],
      "Pedidos":["pedido","solicitud","certificado","manual"],
      "Acciones Talleres":["talleres","partido","certificado talleres","presencia"],
      "Becas":["beca","media beca","ayuda económica"],
      "Base de datos":["base de datos","datos","listado","padrón","colegios provienen"],
      "Pagos":["pago","pagos","semestre completo","link de pago"],
      "Competencia":["competencia","competidor","relevamiento"],
      "CCAP":["ccap","diplomatura","unidad","consultas"]
    };

    function normalizeTextForDetection(text){
      return String(text || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }

    function detectCategory(title, description, substatus){
      const source = normalizeTextForDetection([title, description, substatus].join(" "));
      let bestCategory = "Pedidos";
      let bestScore = 0;
      for(const [category, keywords] of Object.entries(categoryKeywordMap)){
        let score = 0;
        for(const keyword of keywords){
          const normalizedKeyword = normalizeTextForDetection(keyword);
          if(source.includes(normalizedKeyword)) score += normalizedKeyword.includes(" ") ? 3 : 1;
        }
        if(score > bestScore){ bestScore = score; bestCategory = category; }
      }
      return bestCategory;
    }

    function updateDetectedCategoryPreview(){
      const preview = $("categoryPreview");
      const value = $("categoryPreviewValue");
      if(!preview || !value) return;

      const auto = $("categoryMode").value === "auto";
      const title = $("taskTitle").value.trim();
      const description = $("taskDescription").value.trim();
      const substatus = $("taskSubstatus").value.trim();
      const hasContent = Boolean(title || description || substatus);

      if(!auto || !hasContent){
        preview.hidden = true;
        value.textContent = "";
        return;
      }

      const detected = detectCategory(title, description, substatus);
      value.textContent = detected;
      preview.hidden = false;
    }

    function updateCategoryModeUI(){
      const auto = $("categoryMode").value === "auto";
      $("taskArea").disabled = auto;
      $("taskArea").required = !auto;
      $("taskArea").placeholder = auto ? "Se completará automáticamente" : "Ej.: Inscripciones";
      $("categoryDetectionHint").textContent = auto
        ? "La vista previa se actualiza mientras escribís."
        : "Elegí una categoría manualmente.";
      updateDetectedCategoryPreview();
    }

    function renderBoard(){
      ensureTaskStatuses();
      renderSelectors();

      document.getElementById("app").classList.toggle("compact", compactMode);

      const rows = filteredTasks();
      const areas = uniqueAreas();
      const board = $("board");

      board.innerHTML = areas.map(area => {
        const info = columnInfo(area);
        const items = rows.filter(t => t.area === area);
        if(items.length === 0 && (onlyPending || $("searchInput").value || $("areaFilter").value || $("statusFilter").value || $("substatusFilter").value || $("deadlineFilter").value)) return "";
        const pendingCount = tasks.filter(t => t.area === area && t.status !== "completada").length;
        const collapsed = collapsedAreas.has(area);

        return `
          <section class="column ${collapsed ? "collapsed" : ""}">
            <div class="col-head">
              <div class="col-main" style="background:${info.color}">
                <div class="col-left">
                  <span class="lucide-col"><i data-lucide="${info.icon}"></i></span>
                  <div class="col-title">
                    <span class="col-title-text">${esc(area)}</span>
                    <div class="count">${pendingCount} pendiente${pendingCount===1?"":"s"}</div>
                  </div>
                </div>
                <button class="collapse" onclick="toggleColumn('${encodeURIComponent(area)}')" title="Contraer / expandir">${collapsed ? "+" : "−"}</button>
              </div>
            </div>
            <div class="column-body">
              <div class="quick-add">
                <input id="quick-${slug(area)}" class="field" placeholder="Agregar tarea rápida..." />
                <button class="btn" onclick="quickAdd('${encodeURIComponent(area)}')">Agregar</button>
              </div>
              <div class="task-list">
                ${items.length ? items.map(taskCard).join("") : `<div class="empty">Sin tareas para mostrar.</div>`}
              </div>
              <div class="column-footer">
                <button class="btn" onclick="openTaskDialog('${encodeURIComponent(area)}')">+ Nueva tarea en esta columna</button>
              </div>
            </div>
          </section>
        `;
      }).join("");

      renderStats();

      $("pendingBtn").classList.toggle("active", onlyPending);
      

      $("compactBtn").classList.toggle("active", compactMode);
      $("compactBtn").innerHTML = compactMode ? '<i data-lucide="columns-3"></i> Vista simple activada' : '<i data-lucide="columns-3"></i> Vista compacta';
      $("pendingBtn").innerHTML = onlyPending ? '<i data-lucide="list-filter"></i> Mostrando solo no realizadas' : '<i data-lucide="list-filter"></i> Solo no realizadas';
      setTimeout(()=>{ setupSyncedScrollbars(); refreshIcons(); },0);
    }

    function openTaskDialog(areaEncoded=""){
      $("taskForm").reset();
      $("taskId").value = "";
      $("taskDialogTitle").textContent = "Nueva tarea";
      $("taskArea").value = areaEncoded ? decodeURIComponent(areaEncoded) : "";
      $("categoryMode").value = areaEncoded ? "manual" : "auto";
      updateCategoryModeUI();
      $("taskStatus").value = getStatuses()[0]?.id || "urgente";
      $("taskPriority").value = "media";
      $("taskSubstatus").value = "";
      workingAttachments = [];
      $("attachmentEditList").innerHTML = "";
      $("taskAttachments").value = "";
      $("taskDialog").showModal();
      updateDetectedCategoryPreview();
    }

    function renderAttachmentEditor(){
      const box = $("attachmentEditList");
      box.innerHTML = workingAttachments.length ? workingAttachments.map((a, idx) => `
        <div class="attachment-edit-item">
          <span><i data-lucide="paperclip"></i> ${esc(a.name)}</span>
          <button type="button" class="mini" onclick="removeWorkingAttachment(${idx})">Quitar</button>
        </div>
      `).join("") : `<div class="hint">Todavía no hay adjuntos cargados.</div>`;
    }

    function removeWorkingAttachment(index){
      workingAttachments.splice(index, 1);
      renderAttachmentEditor();
    }

    async function filesToAttachments(fileList){
      const files = [...fileList];
      return Promise.all(files.map(file => new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve({
          name:file.name,
          type:file.type,
          size:file.size,
          data:reader.result
        });
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(file);
      })));
    }

    $("categoryMode").addEventListener("change", updateCategoryModeUI);
    ["taskTitle","taskDescription","taskSubstatus"].forEach(id => {
      $(id).addEventListener("input", updateDetectedCategoryPreview);
    });

    $("taskAttachments").addEventListener("change", async e => {
      const files = e.target.files;
      if(!files || !files.length) return;
      try{
        const data = await filesToAttachments(files);
        workingAttachments = workingAttachments.concat(data);
        renderAttachmentEditor();
        $("taskAttachments").value = "";
        toast("Adjunto agregado");
      }catch(err){
        console.error(err);
        toast("No se pudo leer el adjunto");
      }
    });

    function editTask(id){
      const task = tasks.find(t => t.id === id);
      if(!task) return;
      $("taskId").value = task.id;
      $("taskTitle").value = task.title || "";
      $("taskArea").value = task.area || "";
      $("categoryMode").value = task.categoryMode || "manual";
      updateCategoryModeUI();
      $("taskOwner").value = task.owner || "";
      $("taskDeadline").value = task.deadline || "";
      $("taskStatus").value = task.status || getStatuses()[0]?.id || "urgente";
      $("taskSubstatus").value = task.substatus || "";
      $("taskPriority").value = task.priority || "media";
      $("taskDescription").value = task.description || "";
      workingAttachments = Array.isArray(task.attachments) ? [...task.attachments] : [];
      renderAttachmentEditor();
      $("taskAttachments").value = "";
      $("taskDialogTitle").textContent = "Editar tarea";
      $("taskDialog").showModal();
      updateDetectedCategoryPreview();
    }

    function deleteTask(id){
      if(!confirm("¿Eliminar esta tarea?")) return;
      tasks = tasks.filter(t => t.id !== id);
      saveTasksCloudReady();
      queueReminderSync();
      renderBoard();
    setTimeout(()=>{ refreshIcons(); setupSyncedScrollbars(); initializeFirebaseIfConfigured(); },50);
      toast("Tarea eliminada");
    }

    function duplicateTask(id){
      const task = tasks.find(t => t.id === id);
      if(!task) return;
      tasks.push({...task, id:crypto.randomUUID(), title: task.title + " (copia)"});
      saveTasksCloudReady();
      queueReminderSync();
      renderBoard();
      toast("Tarea duplicada");
    }

    function toggleDone(id, checked){
      const task = tasks.find(t => t.id === id);
      if(!task) return;
      task.status = checked ? "completada" : (getStatuses()[0]?.id || "pendiente");
      saveTasksCloudReady();
      queueReminderSync();
      renderBoard();
    }

    function toggleColumn(areaEncoded){
      const area = decodeURIComponent(areaEncoded);
      if(collapsedAreas.has(area)) collapsedAreas.delete(area);
      else collapsedAreas.add(area);
      saveSettings();
      renderBoard();
    }

    function quickAdd(areaEncoded){
      const area = decodeURIComponent(areaEncoded);
      const input = document.getElementById("quick-" + slug(area));
      if(!input) return;
      const title = input.value.trim();
      if(!title) return;

      tasks.push({
        id:crypto.randomUUID(),
        title,
        area,
        owner:"",
        deadline:"",
        status:getStatuses()[0]?.id || "urgente",
        substatus:"",
        priority:"media",
        description:"",
        attachments:[]
      });

      input.value = "";
      saveTasksCloudReady();
      queueReminderSync();
      renderBoard();
      toast("Tarea agregada");
    }

    $("taskForm").addEventListener("submit", e => {
      e.preventDefault();
      const id = $("taskId").value;
      const categoryMode = $("categoryMode").value;
      const title = $("taskTitle").value.trim();
      const description = $("taskDescription").value.trim();
      const substatus = $("taskSubstatus").value.trim();
      const detectedArea = detectCategory(title, description, substatus);

      const data = {
        id: id || crypto.randomUUID(),
        title,
        area: categoryMode === "auto" ? detectedArea : $("taskArea").value.trim(),
        categoryMode,
        owner: $("taskOwner").value.trim(),
        deadline: $("taskDeadline").value,
        status: $("taskStatus").value,
        substatus,
        priority: $("taskPriority").value,
        description,
        attachments: [...workingAttachments]
      };

      if(!data.title || (!data.area && categoryMode === "manual")){
        toast("Completá al menos el título y la categoría");
        return;
      }

      if(id){
        tasks = tasks.map(t => t.id === id ? data : t);
        toast("Tarea actualizada");
      }else{
        tasks.push(data);
        toast("Tarea creada");
      }

      saveTasksCloudReady();
      queueReminderSync();
      $("taskDialog").close();
      renderBoard();
    });

    function renderConfigDialog(){
      const statusBox = $("statusConfigList");
      const subBox = $("substatusConfigList");

      statusBox.innerHTML = getStatuses().map((s, i) => `
        <div class="config-row">
          <input class="field status-label" data-index="${i}" value="${esc(s.label)}" placeholder="Etiqueta" />
          <input class="field status-id" data-index="${i}" value="${esc(s.id)}" placeholder="id" />
          <input type="color" class="field status-color" data-index="${i}" value="${esc(normalizeColor(s.color))}" />
          <button type="button" class="btn" onclick="removeStatusRow(${i})">Quitar</button>
        </div>
      `).join("");

      subBox.innerHTML = getSubstatuses().map((s, i) => `
        <div class="config-row sub">
          <input class="field substatus-label" data-index="${i}" value="${esc(s)}" placeholder="Subestado" />
          <button type="button" class="btn" onclick="removeSubstatusRow(${i})">Quitar</button>
        </div>
      `).join("");
    }

    function normalizeColor(c){
      const s = String(c || "").trim();
      if(/^#[0-9a-fA-F]{6}$/.test(s)) return s;
      if(/^#[0-9a-fA-F]{3}$/.test(s)) return "#" + s.slice(1).split("").map(ch => ch + ch).join("");
      return "#d9e2ef";
    }

    function removeStatusRow(index){
      if(getStatuses().length <= 1){
        toast("Debe quedar al menos un estado");
        return;
      }
      settings.statuses.splice(index, 1);
      renderConfigDialog();
    }

    function removeSubstatusRow(index){
      settings.substatuses.splice(index, 1);
      renderConfigDialog();
    }

    $("addStatusBtn").addEventListener("click", () => {
      settings.statuses.push({
        id: "nuevo-" + Math.random().toString(36).slice(2,6),
        label: "Nuevo estado",
        color: "#d9e2ef"
      });
      renderConfigDialog();
    });

    $("addSubstatusBtn").addEventListener("click", () => {
      settings.substatuses.push("Nuevo subestado");
      renderConfigDialog();
    });

    $("configBtn").addEventListener("click", () => {
      renderConfigDialog();
      $("configDialog").showModal();
    });

    $("configForm").addEventListener("submit", e => {
      e.preventDefault();

      const labels = [...document.querySelectorAll(".status-label")];
      const ids = [...document.querySelectorAll(".status-id")];
      const colors = [...document.querySelectorAll(".status-color")];
      const newStatuses = [];

      labels.forEach((input, i) => {
        const label = input.value.trim();
        const id = ids[i].value.trim().toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");
        const color = colors[i].value;
        if(label && id){
          newStatuses.push({id, label, color});
        }
      });

      if(!newStatuses.length){
        toast("Cargá al menos un estado");
        return;
      }

      const newSubstatuses = [...document.querySelectorAll(".substatus-label")]
        .map(i => i.value.trim())
        .filter(Boolean);

      const prevMap = new Map(getStatuses().map(s => [s.id, s.id]));
      const oldFirst = getStatuses()[0]?.id || "pendiente";
      const newFirst = newStatuses[0].id;

      tasks = tasks.map(t => {
        if(newStatuses.some(s => s.id === t.status)) return t;
        return {...t, status: newFirst};
      });

      settings.statuses = newStatuses;
      settings.substatuses = newSubstatuses.length ? newSubstatuses : defaultSubstatuses;
      saveSettings();
      saveTasksCloudReady();
      $("configDialog").close();
      renderBoard();
      toast("Configuración actualizada");
    });


    $("integrationBtn").addEventListener("click", () => {
      $("firebaseConfig").value = settings.firebaseConfig || JSON.stringify(DEFAULT_FIREBASE_CONFIG, null, 2);
      $("reminderEmail").value = settings.reminderEmail || "lucasabraham1996@gmail.com";
      $("reminderWhatsapp").value = settings.reminderWhatsapp || "5493515580770";
      $("reminderEndpoint").value = settings.reminderEndpoint || "";
      $("integrationDialog").showModal();
    });

    $("integrationForm").addEventListener("submit", async e => {
      e.preventDefault();
      const firebaseRaw = $("firebaseConfig").value.trim();
      if(firebaseRaw){
        try{ JSON.parse(firebaseRaw); }
        catch{ toast("La configuración Firebase no es un JSON válido"); return; }
      }
      settings.firebaseConfig = firebaseRaw;
      settings.reminderEmail = $("reminderEmail").value.trim();
      settings.reminderWhatsapp = $("reminderWhatsapp").value.trim();
      settings.reminderEndpoint = $("reminderEndpoint").value.trim();
      saveSettings();
      $("integrationDialog").close();
      await initializeFirebaseIfConfigured();
      queueReminderSync();
      toast("Configuración guardada");
    });

    $("newTaskBtn").addEventListener("click", () => openTaskDialog());

    $("pendingBtn").addEventListener("click", () => {
      onlyPending = !onlyPending;
      saveSettings();
      renderBoard();
    });

    $("compactBtn").addEventListener("click", () => {
      compactMode = !compactMode;
      saveSettings();
      renderBoard();
    });

    $("collapseBtn").addEventListener("click", () => {
      collapseAll = !collapseAll;
      if(collapseAll){
        collapsedAreas = new Set(uniqueAreas());
        $("collapseBtn").textContent = "Expandir todo";
      }else{
        collapsedAreas = new Set();
        $("collapseBtn").textContent = "Contraer todo";
      }
      saveSettings();
      renderBoard();
    });

    ["searchInput","areaFilter","statusFilter","substatusFilter","deadlineFilter"].forEach(id => {
      $(id).addEventListener(id === "searchInput" ? "input" : "change", renderBoard);
    });

    $("clearFiltersBtn").addEventListener("click", () => {
      $("searchInput").value = "";
      $("areaFilter").value = "";
      $("statusFilter").value = "";
      $("substatusFilter").value = "";
      $("deadlineFilter").value = "";
      renderBoard();
    });


    function refreshIcons(){
      if(window.lucide) window.lucide.createIcons();
    }

    function setupSyncedScrollbars(){
      const board = $("board");
      const top = $("topScroll");
      const inner = $("topScrollInner");
      if(!board || !top || !inner) return;
      inner.style.width = board.scrollWidth + "px";
      let syncing = false;
      top.onscroll = () => {
        if(syncing) return;
        syncing = true;
        board.scrollLeft = top.scrollLeft;
        requestAnimationFrame(()=>syncing=false);
      };
      board.onscroll = () => {
        if(syncing) return;
        syncing = true;
        top.scrollLeft = board.scrollLeft;
        requestAnimationFrame(()=>syncing=false);
      };
    }

    async function initializeFirebaseIfConfigured(){
      const raw = settings.firebaseConfig;
      if(!raw || !window.initCanvasFirebase) return;
      try{
        const config = typeof raw === "string" ? JSON.parse(raw) : raw;
        const db = await window.initCanvasFirebase(config);
        if(db && settings.loadFromFirestore === true){
          const remote = await window.loadTasksFromFirestore();
          if(Array.isArray(remote) && remote.length){
            tasks = remote;
            localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));
            renderBoard();
          }
        }
      }catch(err){
        console.error(err);
      }
    }

    function saveTasksCloudReady(){
      saveTasks();
      if(window.canvasFirestore && window.syncTasksToFirestore){
        window.syncTasksToFirestore(tasks).catch(console.error);
      }
    }

    function queueReminderSync(){
      const endpoint = settings.reminderEndpoint;
      if(!endpoint) return;
      const payload = {
        email: settings.reminderEmail || "lucasabraham1996@gmail.com",
        whatsapp: settings.reminderWhatsapp || "5493515580770",
        tasks: tasks.filter(t => t.deadline && t.status !== "completada")
      };
      fetch(endpoint, {
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify(payload)
      }).catch(err => console.error("Reminder endpoint:", err));
    }

    function toast(message){
      const el = document.createElement("div");
      el.className = "toast";
      el.textContent = message;
      $("toastWrap").appendChild(el);
      setTimeout(() => el.remove(), 3200);
    }

    window.openTaskDialog = openTaskDialog;
    window.editTask = editTask;
    window.deleteTask = deleteTask;
    window.duplicateTask = duplicateTask;
    window.toggleDone = toggleDone;
    window.quickAdd = quickAdd;
    window.toggleColumn = toggleColumn;
    window.removeWorkingAttachment = removeWorkingAttachment;
    window.removeStatusRow = removeStatusRow;
    window.removeSubstatusRow = removeSubstatusRow;

    renderBoard();

    const todayKey = new Date().toISOString().slice(0,10);
    const dueCount = tasks.filter(t => t.status !== "completada" && t.deadline && dayDiff(t.deadline) !== null && dayDiff(t.deadline) <= 0).length;
    if(dueCount && localStorage.getItem("lastDueToastAdvanced") !== todayKey){
      toast(`Tenés ${dueCount} tareas vencidas o con vencimiento hoy`);
      localStorage.setItem("lastDueToastAdvanced", todayKey);
    }
  </script>

  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-app.js";
    import { getFirestore, collection, getDocs, setDoc, doc } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-firestore.js";

    window.initCanvasFirebase = async function(config){
      try{
        if(!config || !config.projectId) return null;
        const app = initializeApp(config);
        const db = getFirestore(app);
        window.canvasFirestore = db;
        return db;
      }catch(err){
        console.error("Firebase:", err);
        return null;
      }
    };

    window.syncTasksToFirestore = async function(tasks){
      const db = window.canvasFirestore;
      if(!db) return false;
      for(const task of tasks){
        await setDoc(doc(db, "canvas_tasks", task.id), task);
      }
      return true;
    };

    window.loadTasksFromFirestore = async function(){
      const db = window.canvasFirestore;
      if(!db) return null;
      const snap = await getDocs(collection(db, "canvas_tasks"));
      return snap.docs.map(d => ({id:d.id, ...d.data()}));
    };
  </script>

