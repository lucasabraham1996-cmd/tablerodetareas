      return `
        <article class="task ${t.status === "completada" ? "done" : ""} ${due ? "overdue" : ""}" style="${taskStyle(t.status)}">
          <div class="task-top">
            <input class="check" type="checkbox" ${t.status === "completada" ? "checked" : ""} onchange="toggleDone('${t.id}', this.checked)" />
            <div class="task-main">
              <div class="task-title">${esc(t.title)}</div>
              ${t.description ? `<div class="task-desc">${esc(t.description)}</div>` : ""}
              <div class="task-tags">
