    }

    function filteredTasks(){
      const q = $("searchInput").value.trim().toLowerCase();
      const area = $("areaFilter").value;
      const status = $("statusFilter").value;
      const substatus = $("substatusFilter").value;
      const deadline = $("deadlineFilter").value;

      return tasks.filter(t => {
        if(onlyPending && t.status === "completada") return false;
        if(area && t.area !== area) return false;
        if(status && t.status !== status) return false;
        if(substatus && (t.substatus || "") !== substatus) return false;

        const hay = [t.title, t.description, t.owner, t.area, t.substatus].join(" ").toLowerCase();
        if(q && !hay.includes(q)) return false;

        if(deadline){
          const diff = dayDiff(t.deadline);
          if(deadline === "overdue" && !(diff !== null && diff < 0 && t.status !== "completada")) return false;
          if(deadline === "today" && !(diff === 0 && t.status !== "completada")) return false;
          if(deadline === "week" && !(diff !== null && diff >= 0 && diff <= 7 && t.status !== "completada")) return false;
          if(deadline === "none" && t.deadline) return false;
        }

        return true;
      });
    }

